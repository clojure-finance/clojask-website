{:site-title                   "Clojask"
 :author                       "Clojask"
 :description                  "Clojask is a Clojure dataframe library for datasets larger than memory: lazy, parallel, file to file."
 :site-url                     "https://clojure-finance.github.io/clojask-website/"
 :post-root                    "posts"
 :page-root                    "pages"
 :post-root-uri                "posts-output"
 :page-root-uri                "pages-output"
 :tag-root-uri                 "tags-output"
 :author-root-uri              "authors-output"
 :public-dest                  "public"
 :blog-prefix                  "/clojask-website"
 :rss-name                     "feed.xml"
 :recent-posts                 3
 :post-date-format             "yyyy-MM-dd"
 :archive-group-format         "yyyy MMMM"
 :sass-src                     []
 :sass-path                    "sass"
 :theme                        "clojask"
 :resources                    ["img"]
 :keep-files                   [".git"]
 :disqus?                      false
 :disqus-shortname             ""
 :ignored-files                [#"\.#.*" #".*\.swp$"]
 :previews?                    false
 :posts-per-page               5
 :blocks-per-preview           2
 :clean-urls                   :trailing-slash
 :collapse-subdirs?            false
 :hide-future-posts?           true
 :klipse                       {}
 :description-include-elements #{:p :h1 :h2 :h3 :h4 :h5 :h6}
 :debug?                       false

 ;; Shown on the home page and in the sidebar. Also update the install
 ;; snippets in content/md/posts/get-started.md on each release.
 :clojask-version              "2.1.2"

 ;; The sidebar, in reading order. Each page listed here gets "previous" and
 ;; "next" links to its neighbours (see src/cryogen/site.clj). Paths are
 ;; relative to :blog-prefix.
 :docs-nav
 [{:section "Start here"
   :links   [{:title "Home" :path "/"}
             {:title "Get Started" :path "/posts-output/get-started/"}
             {:title "Core Concepts" :path "/posts-output/concepts/"}
             {:title "Cheat Sheet" :path "/posts-output/cheat-sheet/"}]}
  {:section "Reference"
   :links   [{:title "API Docs" :path "/posts-output/API/"}
             {:title "Aggregation Functions" :path "/posts-output/aggregate-function/"}
             {:title "Extensions" :path "/posts-output/extensions/"}]}
  {:section "Learn more"
   :links   [{:title "Examples" :path "/posts-output/examples/"}
             {:title "About & Benchmarks" :path "/pages-output/about/"}]}]}
